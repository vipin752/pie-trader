# PIE Trader gateway — required environment variables.
# Copy to .env (gitignored) and fill in real values. Never commit a
# filled-in copy of this file. See CR-001.E in the security hardening PR.

DB_USERNAME=pietrader
DB_PASSWORD=
REDIS_PASSWORD=

# Angel One SmartAPI — your own broker account's credentials.
ANGELONE_API_KEY=
ANGELONE_CLIENT_ID=
ANGELONE_PASSWORD=
ANGELONE_TOTP_SECRET=
# The IP/MAC Angel One's API expects to be registered for your account.
ANGELONE_LOCAL_IP=
ANGELONE_PUBLIC_IP=
ANGELONE_MAC_ADDRESS=

# Keycloak JWT resource server. JWT_ISSUER_URI must exactly match the
# "issuer" field of your realm's own OIDC discovery document — this is
# normally https://<keycloak-host>/realms/<realm>, not just the host.
# Verify at <issuer>/.well-known/openid-configuration before deploying.
JWT_ISSUER_URI=https://pietrader.in/realms/pie-trader
JWT_AUDIENCE=pie-trader-api

# The real deployed React frontend origin — never a wildcard in
# production. ui/ always listens on :3000 by default (its Express
# server, not a standalone Vite dev server), so that's the real local
# default, not Vite's usual 5173.
PIE_TRADER_FRONTEND_ORIGIN=http://localhost:3000
