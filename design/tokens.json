{
  "$schema": "pie-trader design tokens v1",
  "principles": [
    "Truth first: P&L is shown after charges, never rounded up.",
    "The rule is the hero: every problem links to the rule that fixes it.",
    "Calm, not casino: no flashing, no confetti, no red/green alone. Losses read clearly but don't shout.",
    "Sign + word + colour: money values always carry +/−, never colour alone (colour-blind safe)."
  ],
  "color": {
    "light": {
      "surface-0": "#f6f5f2", "surface-1": "#fcfcfb", "surface-2": "#f0efec", "border": "#e2e0da",
      "text-primary": "#0b0b0b", "text-secondary": "#52514e", "text-muted": "#7a7973",
      "accent": "#2a78d6", "accent-ink": "#1c5cab",
      "profit": "#2a78d6", "profit-ink": "#1c5cab",
      "loss": "#e34948", "loss-ink": "#b42828",
      "neutral": "#f0efec",
      "series-1": "#2a78d6", "series-2": "#eb6834"
    },
    "dark": {
      "surface-0": "#121211", "surface-1": "#1a1a19", "surface-2": "#262624", "border": "#33332f",
      "text-primary": "#f0efec", "text-secondary": "#c3c2b7", "text-muted": "#8f8e86",
      "accent": "#3987e5", "accent-ink": "#86b6ef",
      "profit": "#3987e5", "profit-ink": "#86b6ef",
      "loss": "#e66767", "loss-ink": "#f09a9a",
      "neutral": "#383835",
      "series-1": "#3987e5", "series-2": "#d95926"
    },
    "status": { "good": "#0ca30c", "warning": "#fab219", "serious": "#ec835a", "critical": "#d03b3b" }
  },
  "severity": {
    "critical": { "status": "critical", "icon": "■", "label": "Critical" },
    "high":     { "status": "serious",  "icon": "▲", "label": "High" },
    "medium":   { "status": "warning",  "icon": "●", "label": "Medium" },
    "low":      { "status": "good",     "icon": "○", "label": "Low" }
  },
  "font": {
    "sans": "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
    "mono": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace",
    "numeric": "tabular-nums"
  },
  "type-scale": { "xs": "12px", "sm": "13px", "md": "15px", "lg": "18px", "xl": "24px", "2xl": "32px", "hero": "48px" },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px", "7": "48px", "8": "64px" },
  "radius": { "sm": "4px", "md": "8px", "lg": "12px", "pill": "999px" },
  "shadow": { "card": "0 1px 2px rgb(0 0 0 / .04), 0 1px 1px rgb(0 0 0 / .03)" },
  "chart": { "bar-radius": "4px", "line-width": "2px", "gap": "2px", "marker": "8px", "grid": "border" },
  "money": { "locale": "en-IN", "currency": "INR", "negative": "U+2212 minus, never parentheses", "compact": "₹1.27L / ₹12.5k above ₹10,000" }
}
