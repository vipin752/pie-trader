# infrastructure/docker-compose.yml — required environment variables.
# Copy to infrastructure/.env (gitignored) and fill in real values.
# Never commit a filled-in copy. See CR-001.E in the security hardening PR.

POSTGRES_PASSWORD=
REDIS_PASSWORD=
PGADMIN_DEFAULT_PASSWORD=

# Angel One SmartAPI — your own broker account's credentials.
ANGELONE_API_KEY=
ANGELONE_CLIENT_ID=
ANGELONE_TOTP_SECRET=

# Keycloak JWT resource server. JWT_ISSUER_URI must exactly match the
# "issuer" field of your realm's own OIDC discovery document — normally
# https://<keycloak-host>/realms/<realm>, not just the host. Verify at
# <issuer>/.well-known/openid-configuration before deploying.
JWT_ISSUER_URI=https://pietrader.in/realms/pie-trader
JWT_AUDIENCE=pie-trader-api
PIE_TRADER_FRONTEND_ORIGIN=http://localhost:3000

# ui/'s own Express BFF (frontend service below) — 32+ char random string
# used to sign its PIE session tokens. Generate your own, e.g.
# `openssl rand -base64 32`. Unrelated to Keycloak/JWT above.
PIE_SESSION_SECRET=
PIE_GENAI_PLATFORM_URL=http://localhost:8000
