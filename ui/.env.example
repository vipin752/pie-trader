# OWN_GENAI_ENDPOINT / OWN_GENAI_API_KEY: PIE Trader's own GenAI model/
# service (server/ai/llmGateway.ts's OwnGenAiProviderAdapter — a skeleton
# only, not implemented yet). This is the DEFAULT provider; leaving these
# blank means AI chat/agent features throw a clear "not configured" error
# instead of silently doing nothing or fabricating a response.
OWN_GENAI_ENDPOINT=""
OWN_GENAI_API_KEY=""

# GEMINI_API_KEY: an alternate provider (server/ai/llmGateway.ts's
# GeminiProviderAdapter) — NOT used by default. Only takes effect if
# something explicitly constructs LlmGateway with `new GeminiProviderAdapter()`.
# AI Studio automatically injects this at runtime from user secrets if you
# do choose to use it; configure via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PIE_GENAI_PLATFORM_URL: base URL of the real, standalone PIE GenAI
# Platform service (vipin752/pie-genai-platform — Python/FastAPI,
# self-hosted via Ollama by default). Powers the "PIE GenAI Platform
# (Self-Hosted)" option in the Experience Coach chat and
# server/ai/pieGenAiPlatformBridge.ts. Defaults to http://localhost:8000
# if unset; the bridge fails loudly (never fabricates a reply) if this
# service isn't actually reachable there.
PIE_GENAI_PLATFORM_URL="http://localhost:8000"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PIE_SESSION_SECRET: 32+ char HMAC signing secret for user session tokens.
PIE_SESSION_SECRET=""

# Client OAuth2 / OIDC (User Identity Login — separate from Broker API Auth)
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

MICROSOFT_OAUTH_CLIENT_ID=""
MICROSOFT_OAUTH_CLIENT_SECRET=""
MICROSOFT_OAUTH_TENANT="common"

# This is also where Keycloak goes — there is no separate "Keycloak"
# provider because this generic OIDC one already covers it. Point it at
# your realm's own endpoints (replace pietrader.in/pie-trader with your
# actual host/realm — see backend/pietrader-gateway/.env.example's
# JWT_ISSUER_URI, which must match this realm):
#   CUSTOM_OIDC_AUTH_URL=https://pietrader.in/realms/pie-trader/protocol/openid-connect/auth
#   CUSTOM_OIDC_TOKEN_URL=https://pietrader.in/realms/pie-trader/protocol/openid-connect/token
#   CUSTOM_OIDC_USERINFO_URL=https://pietrader.in/realms/pie-trader/protocol/openid-connect/userinfo
# This is an Express-mediated authorization-code flow (same pattern as
# the Google/Microsoft providers above, both confidential clients with a
# secret): PKCE is still used, but the code<->token exchange happens
# server-side in Express, which can hold a client secret safely (it's
# never sent to the browser). So configure a CONFIDENTIAL Keycloak
# client here (Client authentication: On), not the public
# "pie-trader-web" SPA client described elsewhere for a direct
# browser<->Keycloak flow — this repo's actual UI doesn't do that.
# A real token from this provider is what gets forwarded to
# backend/pietrader-gateway as Authorization: Bearer — see
# server/auth/authService.ts's getGatewayAccessToken().
CUSTOM_OIDC_NAME="Keycloak"
CUSTOM_OIDC_CLIENT_ID=""
CUSTOM_OIDC_CLIENT_SECRET=""
CUSTOM_OIDC_AUTH_URL=""
CUSTOM_OIDC_TOKEN_URL=""
CUSTOM_OIDC_USERINFO_URL=""
CUSTOM_OIDC_SCOPES="openid email profile"

